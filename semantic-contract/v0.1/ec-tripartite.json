    { "id": "assumption-p2-r2-3", "statement": "Final choice gives patients meaningful control", "subject": { "kind": "RELATION", "relationId": "rel-p2-r2" } },
    { "id": "assumption-p3-r3-1", "statement": "Insurers have the data needed to compare treatment costs", "subject": { "kind": "RELATION", "relationId": "rel-p3-r3" } },
