{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltp-workbench.dev/schemas/definition/v1/layout-presentation.schema.json",
  "$defs": {
    "layoutProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directions", "defaultDirection", "layering", "cycleBreaking", "routingStyles", "defaultRoutingStyle"],
      "properties": {
        "directions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["TB", "BT", "LR", "RL"] }
        },
        "defaultDirection": { "enum": ["TB", "BT", "LR", "RL"] },
        "layering": { "enum": ["DISTANCE_TO_SINK", "CANONICAL_ROLES", "FREE"] },
        "cycleBreaking": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "restoreSemanticEdges"],
          "properties": {
            "strategy": { "enum": ["FORBIDDEN", "GREEDY_FEEDBACK_ARC"] },
            "restoreSemanticEdges": { "type": "boolean" }
          }
        },
        "routingStyles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["CURVED", "ORTHOGONAL", "POLYLINE"] }
        },
        "defaultRoutingStyle": { "enum": ["CURVED", "ORTHOGONAL", "POLYLINE"] }
      }
    },
    "elementStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeId", "shape", "colorToken"],
      "properties": {
        "typeId": { "$ref": "common.schema.json#/$defs/typeId" },
        "shape": { "enum": ["RECTANGLE", "ROUNDED_RECTANGLE", "DIAMOND", "CIRCLE"] },
        "colorToken": { "$ref": "common.schema.json#/$defs/memberId" }
      }
    },
    "relationStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typeId", "lineStyle", "arrowHead"],
      "properties": {
        "typeId": { "$ref": "common.schema.json#/$defs/typeId" },
        "lineStyle": { "enum": ["SOLID", "DASHED"] },
        "arrowHead": { "enum": ["NONE", "STANDARD"] }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elementStyles", "relationStyles"],
      "properties": {
        "elementStyles": {
          "type": "array",
          "items": { "$ref": "#/$defs/elementStyle" }
        },
        "relationStyles": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationStyle" }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "parameters"],
            "properties": {
              "capability": { "$ref": "common.schema.json#/$defs/capabilityId" },
              "parameters": {
                "type": "object",
                "additionalProperties": { "$ref": "common.schema.json#/$defs/jsonValue" }
              }
            }
          }
        }
      }
    }
  }
}
