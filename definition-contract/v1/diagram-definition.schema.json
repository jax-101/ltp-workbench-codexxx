{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ltp-workbench.dev/schemas/definition/v1/diagram-definition.schema.json",
  "title": "LTP Workbench Diagram Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "formatVersion", "id", "version", "label", "description",
    "requiredKernelCapabilities", "logicMode", "defaultInputCombination",
    "cyclePolicy", "defaultElementType", "elementTypes", "relationTypes",
    "topology", "validationRules", "creationRecipes", "layoutProfile",
    "presentation", "fixtures"
  ],
  "properties": {
    "$schema": { "const": "https://ltp-workbench.dev/schemas/definition/v1/diagram-definition.schema.json" },
    "formatVersion": { "const": "1" },
    "id": { "$ref": "common.schema.json#/$defs/definitionId" },
    "version": { "$ref": "common.schema.json#/$defs/semanticVersion" },
    "label": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "description": { "$ref": "common.schema.json#/$defs/description" },
    "requiredKernelCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/capabilityId" }
    },
    "logicMode": { "enum": ["SUFFICIENCY", "NECESSITY"] },
    "defaultInputCombination": { "enum": ["OR", "AND"] },
    "cyclePolicy": { "enum": ["ALLOWED", "FORBIDDEN", "WARNING"] },
    "defaultElementType": { "$ref": "common.schema.json#/$defs/typeId" },
    "elementTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "semantic.schema.json#/$defs/elementType" }
    },
    "relationTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "semantic.schema.json#/$defs/relationType" }
    },
    "topology": { "$ref": "semantic.schema.json#/$defs/topology" },
    "validationRules": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "semantic.schema.json#/$defs/rule" }
    },
    "creationRecipes": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "semantic.schema.json#/$defs/recipe" }
    },
    "layoutProfile": { "$ref": "layout-presentation.schema.json#/$defs/layoutProfile" },
    "presentation": { "$ref": "layout-presentation.schema.json#/$defs/presentation" },
    "fixtures": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/memberId" },
          "path": {
            "type": "string",
            "pattern": "^fixtures/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.json$"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authors": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }
        },
        "license": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
        "homepage": { "type": "string", "format": "uri" }
      }
    }
  }
}
