{
  "schemaVersion": 1,
  "id": "definition-runtime",
  "status": "transitional",
  "purpose": "Load, validate, version and compile declarative diagram packages through one safe runtime.",
  "owns": ["definition schema", "canonical serialization", "definition hash", "package loading", "resource policy", "version resolution", "capability compilation", "definition diagnostics"],
  "doesNotOwn": ["diagram instances", "workspace files", "semantic mutations", "layout execution", "Studio UI"],
  "invariants": ["Definitions contain no executable code.", "Official and user packages use the same loader.", "Published versions are immutable."],
  "allowedDependencies": [],
  "forbiddenDependencies": ["application", "workspace", "layout", "view", "adapters", "diagram-studio"],
  "contracts": [
    {
      "id": "definition.artifact.v1",
      "version": 1,
      "status": "implemented",
      "operations": ["validateDefinition", "canonicalSerialize", "hashDefinition", "verifyDefinitionHash", "createDefinitionArtifact"],
      "inputs": ["declarative diagram definition v1"],
      "outputs": ["stable diagnostics", "RFC 8785 canonical UTF-8 JSON", "SHA-256 content identity", "immutable definition artifact"],
      "errors": ["DEFINITION_INVALID", "DEFINITION_VALUE_NOT_JSON"]
    },
    {
      "id": "definition.loading.v1",
      "version": 1,
      "status": "implemented",
      "operations": ["loadDefinition", "createDefinitionPin", "validatePin", "resolvePinnedDefinition"],
      "inputs": ["directory or embedded package source", "supported capabilities", "exact definition pin", "bounded resource policy"],
      "outputs": ["immutable loaded package", "exact content pin", "ready or read-only rescue outcome", "safe diagnostics"],
      "errors": ["DEFINITION_SOURCE_INVALID", "DEFINITION_PACKAGE_MISSING", "DEFINITION_PATH_FORBIDDEN", "DEFINITION_JSON_INVALID", "DEFINITION_RESOURCE_LIMIT", "DEFINITION_PIN_INVALID", "DEFINITION_VERSION_MISSING", "DEFINITION_HASH_MISMATCH", "DEFINITION_CAPABILITY_UNSUPPORTED"]
    },
    {
      "id": "definition.capabilities.v1",
      "version": 1,
      "status": "implemented",
      "operations": ["compileDefinition"],
      "inputs": ["securely loaded definition package", "known declarative capabilities"],
      "outputs": ["immutable semantic profile", "immutable compatibility registry projection", "exact definition pin"],
      "errors": ["DEFINITION_CAPABILITY_UNSUPPORTED", "DEFINITION_COMPILE_INVALID"]
    },
    {
      "id": "definition.migrations.v1",
      "version": 1,
      "status": "implemented",
      "operations": ["compareDefinitions", "createDefinitionMigrationPlan", "applyDefinitionMigration", "rollbackDefinitionMigration"],
      "inputs": ["secure source and target packages", "exact current pin", "explicit breaking-change approval"],
      "outputs": ["deterministic migration plan", "exact pin transition", "verifiable rollback receipt"],
      "errors": ["DEFINITION_MIGRATION_INVALID", "DEFINITION_MIGRATION_ID_MISMATCH", "DEFINITION_MIGRATION_VERSION_INVALID", "DEFINITION_MIGRATION_STALE", "DEFINITION_MIGRATION_BREAKING_APPROVAL_REQUIRED", "DEFINITION_MIGRATION_RECEIPT_INVALID"]
    },
    {
      "id": "definition.tooling.v1",
      "version": 1,
      "status": "implemented",
      "operations": ["inspectDefinitionPackage", "verify package", "list package library", "preview/apply/rollback migration"],
      "inputs": ["confined directory package", "package library", "pin or receipt JSON"],
      "outputs": ["immutable package summary", "verification result", "migration contract values"],
      "errors": ["definition loading, compilation and migration error codes"]
    }
  ],
  "acceptance": { "status": "transitional", "command": "node scripts/module-acceptance/definition-runtime.js" }
}
