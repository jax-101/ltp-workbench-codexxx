{
  "name": "ltp-workbench",
  "version": "0.1.0",
  "ltpBuild": {
    "id": "3C.15b",
    "name": "Secure Definition Loader",
    "channel": "prototype"
  },
  "description": "Standalone desktop app for working through problems with Dettmer's Logical Thinking Process.",
  "main": "src/main.js",
  "bin": {
    "ltp": "scripts/ltp-cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test:manual": "LTP_MANUAL_TEST=1 LTP_USE_SAMPLE=1 electron .",
    "test:architecture": "node scripts/test-architecture.js",
    "test:contracts": "node scripts/test-contract-inventory.js",
    "test:module-contracts": "node scripts/test-module-contracts.js",
    "test:modules": "node scripts/test-module-acceptance.js",
    "test:plan": "node scripts/test-plan.js",
    "test:ci": "node scripts/test-ci-workflow.js",
    "plan:write": "node scripts/plan-status.js --write",
    "scope:status": "node scripts/scope-status.js",
    "scope:record-effort": "node scripts/record-effort.js",
    "test:complex": "LTP_COMPLEX_TEST=1 electron .",
    "smoke": "LTP_SMOKE_TEST=1 LTP_USE_SAMPLE=1 LTP_MANUAL_TEST=1 electron .",
    "test:visual": "LTP_VISUAL_TEST=1 LTP_USE_SAMPLE=1 electron .",
    "test:shortcuts": "LTP_SHORTCUT_TEST=1 LTP_USE_SAMPLE=1 electron .",
    "test:prototype": "node scripts/test-prototype.js",
    "test:core": "node scripts/test-core.js",
    "test:workspace-manager": "node scripts/test-workspace-manager.js",
    "test:semantic": "node scripts/test-semantic-contract.js",
    "test:definition": "node scripts/test-definition-artifact.js",
    "test:definition-loader": "node scripts/test-definition-loader.js",
    "test:semantic-migration": "node scripts/test-semantic-migration.js",
    "test:crt": "node scripts/test-crt-vertical.js",
    "test:crt:visual": "LTP_CRT_TEST=1 electron .",
    "test:ec": "node scripts/test-ec-cloud.js",
    "test:ec:visual": "LTP_EC_TEST=1 electron .",
    "test:ec:tripartite:visual": "LTP_EC_TRIPARTITE_TEST=1 electron .",
    "test:layout": "node scripts/test-layout.js",
    "test:layout-random": "node scripts/test-random-layouts.js",
    "fixture:complex": "node scripts/build-complex-fixture.js",
    "fixture:crt": "node scripts/build-crt-fixture.js",
    "fixture:ec": "node scripts/build-ec-fixture.js",
    "ltp": "node scripts/ltp-cli.js",
    "validate:model": "node scripts/validate-model.js",
    "package": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "ltp",
    "logical-thinking-process",
    "electron"
  ],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.ltpworkbench",
    "productName": "LTP Workbench",
    "directories": {
      "output": "outputs/dist"
    },
    "files": [
      "src/**/*",
      "scripts/ltp-cli.js",
      "semantic-contract/**/*",
      "definition-contract/**/*",
      "outputs/sample-workspace-v0.1.json",
      "outputs/complex-goal-tree-workspace-v0.1.json",
      "outputs/crt-workspace-v0.1.json",
      "outputs/ec-workspace-v0.1.json",
      "outputs/ec-tripartite-workspace-v0.1.json",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "ajv": "8.20.0",
    "elkjs": "^0.11.1",
    "immer": "^10.2.0",
    "proper-lockfile": "^4.1.2"
  }
}
